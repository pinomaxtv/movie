# ==============================================================================
# Telegram MTProto Media Streaming & Direct Downloader Engine
# Bypass 20MB Bot API Limit - HTTP 206 Range Streaming Up to 2GB
# ==============================================================================

# Server Environment
PORT=3000
NODE_ENV=production

# Public Base URL of your deployed application (e.g. Render.com URL or Custom Domain)
# Example: https://telegram-video-streamer.onrender.com
APP_URL=http://localhost:3000

# Telegram MTProto Credentials (Obtain from https://my.telegram.org -> API development tools)
# Required for 2GB MTProto direct file streaming
API_ID=
API_HASH=

# Telegram Bot Token (Obtain from @BotFather on Telegram)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram Admin ID (Your numerical Telegram user ID from @userinfobot)
# Only this admin ID is authorized to upload files via the bot
ADMIN_ID=123456789

# MongoDB Atlas Connection String (Mongoose stream_files collection)
# Example: mongodb+srv://<dbuser>:<dbpassword>@cluster0.mongodb.net/telegram_streamer?retryWrites=true&w=majority
MONGODB_URI=

# Firebase Realtime Database URL (Optional Media Catalog)
FIREBASE_DATABASE_URL=https://jetmax-f3e8e-default-rtdb.firebaseio.com

# Optional TMDB API Key (v3 auth key for metadata auto-fetch)
TMDB_API_KEY=
