<!DOCTYPE html>
<html lang="tl" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'PINOMAX - Streaming Portal' %></title>
  
  <!-- Telegram WebApp SDK -->
  <script src="https://telegram.org/js/telegram-web-app.js"></script>

  <!-- Tailwind CSS & Lucide Icons -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #08090d;
      color: #f1f3f7;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .card-movie {
      background: linear-gradient(135deg, #131622 0%, #0d0f18 100%);
      border: 1px solid #1f2436;
      border-radius: 16px;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .card-movie:active {
      transform: scale(0.97);
    }

    /* CAROUSEL STYLING */
    .carousel-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.7s ease, visibility 0.7s ease;
    }
    .carousel-slide.active {
      opacity: 1;
      visibility: visible;
    }
  </style>
</head>
<body class="bg-[#08090d] text-zinc-100 min-h-screen flex flex-col antialiased">

  <!-- 1. TOP COMPACT HEADER -->
  <header class="sticky top-0 z-40 border-b border-[#1f2436] bg-[#08090d]/95 backdrop-blur-md">
    <div class="max-w-md mx-auto px-4 h-14 flex items-center justify-between gap-2">
      
      <a href="/" class="flex items-center gap-2">
        <span class="text-xl">🎬</span>
        <span class="text-base font-black tracking-wider text-white">
          PINO<span class="text-rose-500">MAX</span>
        </span>
      </a>

      <div class="flex items-center gap-2">
        <button onclick="openVipModal('donate')" class="px-3 py-1 rounded-full bg-gradient-to-r from-amber-400 to-amber-500 text-black font-extrabold text-[11px] shadow-md flex items-center gap-1 active:scale-95 transition">
          <span>💎</span> VIP / DONATE
        </button>
        <span id="titlesBadge" class="px-2.5 py-0.5 rounded-full bg-[#141724] border border-[#23293d] text-[10px] font-mono text-zinc-300">
          Loading...
        </span>
      </div>

    </div>
  </header>

  <!-- 2. MAIN CONTAINER -->
  <main class="flex-1 max-w-md w-full mx-auto px-4 py-3 space-y-4">

    <!-- SEARCH BAR -->
    <div class="relative">
      <i data-lucide="search" class="w-4 h-4 text-zinc-500 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
      <input 
        type="text" 
        id="searchInput"
        oninput="liveFilterMovies()"
        placeholder="Maghanap ng pelikula o serye..." 
        autocomplete="off"
        class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-[#131622] border border-[#1f2436] text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-rose-500"
      >
    </div>

    <!-- 3. DYNAMIC HERO CAROUSEL -->
    <div id="carouselWrapper" class="relative w-full aspect-[16/9] rounded-2xl overflow-hidden border border-[#1f2436] bg-[#10121a] shadow-xl">
      <div id="carouselSlides" class="relative w-full h-full">
        <!-- Kusang pupunuin ng JavaScript mula sa latest movies -->
      </div>
      <!-- Dots Indicator -->
      <div id="carouselDots" class="absolute bottom-2.5 left-0 right-0 flex justify-center gap-1.5 z-10"></div>
    </div>

    <!-- SECTION TITLE -->
    <div class="flex items-center justify-between pt-1">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-4 bg-rose-500 rounded-full"></span>
        <h2 class="text-xs font-black uppercase tracking-wider text-white">Stream Catalog</h2>
      </div>
      <span class="text-[10px] text-zinc-500 font-semibold">HD • Tagalog Dubbed</span>
    </div>

    <!-- 4. LISTAHAN NG MOVIES & AUTO-GROUPED SERIES -->
    <div id="moviesContainer" class="space-y-3">
      <!-- Dito kusang ipapasok ang grouped series at standalone movies -->
    </div>

  </main>

  <!-- ========================================================================= -->
  <!-- 5. EPISODE PICKER MODAL (PARA SA SERIES TULAD NG MOUSETRAP) -->
  <!-- ========================================================================= -->
  <div id="episodeModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-[#131622] border border-[#23293d] rounded-t-3xl sm:rounded-2xl w-full max-w-md max-h-[80vh] flex flex-col p-5 shadow-2xl space-y-4 text-white">
      
      <div class="flex items-center justify-between border-b border-[#202433] pb-3">
        <div class="flex items-center gap-2">
          <span class="text-lg">📺</span>
          <div>
            <h3 id="epModalTitle" class="text-xs font-black uppercase text-white truncate max-w-[240px]">Series Title</h3>
            <p id="epModalSub" class="text-[10px] text-rose-400 font-bold">Pumili ng Episode</p>
          </div>
        </div>
        <button onclick="closeEpisodeModal()" class="text-zinc-400 hover:text-white text-xl px-2">&times;</button>
      </div>

      <!-- Episodes Grid / List -->
      <div id="episodesListContainer" class="flex-1 overflow-y-auto space-y-2 pr-1">
        <!-- Dito lalabas ang Episode 1 hanggang 10 -->
      </div>

    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 6. VIP & PAYMENT MODAL -->
  <!-- ========================================================================= -->
  <div id="vipPaymentModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="bg-[#141721] border border-[#262c3f] rounded-2xl w-full max-w-sm p-5 shadow-2xl space-y-4 text-white">
      
      <div class="flex items-center justify-between border-b border-[#202433] pb-2">
        <h3 class="text-xs font-bold text-amber-400 uppercase tracking-wide">👑 VIP Access &amp; Support</h3>
        <button onclick="closeVipModal()" class="text-zinc-400 hover:text-white">&times;</button>
      </div>

      <!-- Tabs -->
      <div class="grid grid-cols-2 gap-2 bg-[#0c0d12] p-1 rounded-xl">
        <button id="tabDonateBtn" onclick="switchPlanTab('donate')" class="py-1 text-xs font-bold rounded-lg bg-amber-500 text-black">
          ❤️ Donate (₱5)
        </button>
        <button id="tabPlansBtn" onclick="switchPlanTab('plans')" class="py-1 text-xs font-semibold rounded-lg text-zinc-400">
          👑 VIP Plans
        </button>
      </div>

      <!-- Donate Box -->
      <div id="donateSection" class="p-3 rounded-xl border border-amber-500/30 bg-amber-950/20 flex items-center justify-between">
        <div>
          <h4 class="text-xs font-bold">Donate sa Server</h4>
          <p class="text-[10px] text-zinc-400">Suporta sa mabilis na streaming</p>
        </div>
        <span class="text-sm font-extrabold text-amber-400">₱5.00</span>
      </div>

      <!-- VIP Plans List -->
      <div id="plansSection" class="space-y-1.5 hidden">
        <div onclick="selectVipPlan('Monthly Plan', '50')" class="vip-plan-card p-2.5 rounded-xl border border-[#202433] bg-[#0c0d12] flex items-center justify-between cursor-pointer">
          <span class="text-xs font-bold">Monthly (30 Days)</span>
          <span class="text-xs font-bold text-amber-400">₱50</span>
        </div>
        <div onclick="selectVipPlan('Quarterly Plan', '150')" class="vip-plan-card p-2.5 rounded-xl border border-[#202433] bg-[#0c0d12] flex items-center justify-between cursor-pointer">
          <span class="text-xs font-bold">Quarterly (90 Days)</span>
          <span class="text-xs font-bold text-amber-400">₱150</span>
        </div>
        <div onclick="selectVipPlan('Yearly Plan', '250')" class="vip-plan-card p-2.5 rounded-xl border border-[#202433] bg-[#0c0d12] flex items-center justify-between cursor-pointer">
          <span class="text-xs font-bold">Yearly (365 Days)</span>
          <span class="text-xs font-bold text-amber-400">₱250</span>
        </div>
      </div>

      <!-- Payment Method -->
      <div class="space-y-1.5">
        <div class="grid grid-cols-2 gap-2">
          <button type="button" id="btnMethodGcash" onclick="setMethod('GCASH')" class="py-1.5 rounded-lg border border-blue-600 bg-blue-600/20 text-blue-400 font-bold text-xs">
            💙 GCash
          </button>
          <button type="button" id="btnMethodPaypal" onclick="setMethod('PAYPAL')" class="py-1.5 rounded-lg border border-[#202433] bg-[#0c0d12] text-zinc-400 text-xs">
            🅿️ PayPal
          </button>
        </div>

        <div id="accountInfoBox" class="p-2.5 rounded-lg bg-[#0c0d12] border border-[#202433] text-[11px] font-mono">
          <div>GCASH: <span class="font-bold text-white"><%= paymentConfig.gcash_number || '09638924040' %></span></div>
          <div class="text-[9px] text-zinc-400">NAME: <%= paymentConfig.gcash_name || 'PINOMAX ADMIN' %></div>
        </div>
      </div>

      <!-- Ref Input -->
      <input 
        type="text" 
        id="vipRefInput" 
        placeholder="Ilagay ang Ref# ng bayad" 
        class="w-full px-3 py-2 rounded-xl bg-[#0c0d12] border border-[#202433] text-xs text-white placeholder-zinc-500 font-mono"
      >

      <button id="btnSubmitPay" onclick="submitPaymentRequest()" class="w-full py-2.5 rounded-xl bg-rose-600 active:bg-rose-700 text-white font-bold text-xs shadow-lg cursor-pointer">
        IPASA ANG BAYAD (SUBMIT)
      </button>
      <p id="modalStatusMsg" class="text-center text-[10px] hidden"></p>

    </div>
  </div>

  <script>
    // 1. Raw Server Data Injection mula sa EJS
    const RAW_MOVIES = <%- JSON.stringify(typeof movies !== 'undefined' ? movies : []) %>;
    
    // 🧠 2. SMART AUTO-GROUPER (TOTOONG SERIES LANG ANG MAY EPISODES, MOVIE AY PLAY)
    function processAndGroupMedia(items) {
      const singles = [];
      const seriesMap = new Map();

      items.forEach(item => {
        const rawTitle = (item.title || item.file_name || 'Untitled').trim();
        
        // 🎯 Eksaktong pattern lang: S01E01, Season 1 Episode 1, Ep 1, o S1
        const match = rawTitle.match(/\b(?:s(\d+)\s*e(\d+)|season\s*(\d+)\s*episode\s*(\d+)|(?:season|s)\s*(\d+)|(?:episode|ep)\s*(\d+))\b/i);

        // KUNG MAY EKSAKTONG PATTERN NG SEASON O EPISODE (Tulad ng Mousetrap):
        if (match) {
          // Kunin ang buong pamagat bago mag-season/episode
          let seriesName = rawTitle.substring(0, match.index).trim();
          if (!seriesName) seriesName = rawTitle;

          // Tanggalin ang kalat sa dulo tulad ng tuldok o gitling
          seriesName = seriesName
            .replace(/\.mp4|\.mkv|\.webm/gi, '')
            .replace(/tagalog dubbed|tagdub|dubbed|pinoy|tagalog/gi, '')
            .replace(/[\(\)\[\]_\-\.]+$/, '')
            .trim();

          const sNum = match[1] || match[3] || match[5] || 1;
          const eNum = match[2] || match[4] || match[6] || 1;

          const epData = {
            id: item.id || item.node,
            rawTitle: rawTitle,
            season: Number(sNum),
            episode: Number(eNum),
            size: item.size || 'HD',
            rating: item.rating || '8.5'
          };

          const key = seriesName.toLowerCase();
          if (!seriesMap.has(key)) {
            seriesMap.set(key, {
              isSeries: true,
              title: seriesName,
              image: item.image,
              rating: item.rating || '8.5',
              year: item.year || '2024',
              genre: 'SERIES',
              size: item.size,
              episodes: [epData]
            });
          } else {
            seriesMap.get(key).episodes.push(epData);
          }
        } else {
          // 🎬 KUNG WALANG S01E01 O EPISODE: 100% STANDALONE MOVIE ITO!
          singles.push({
            ...item,
            isSeries: false
          });
        }
      });

      // I-sort ang bawat series mula Episode 1 pataas
      seriesMap.forEach(series => {
        series.episodes.sort((a, b) => {
          if (a.season === b.season) return a.episode - b.episode;
          return a.season - b.season;
        });
      });

      return [...Array.from(seriesMap.values()), ...singles];
    }

    const PROCESSED_CATALOG = processAndGroupMedia(RAW_MOVIES);
    document.getElementById('titlesBadge').innerText = `${PROCESSED_CATALOG.length} Titles`;

    // 🎠 3. HERO CAROUSEL ENGINE
    let currentSlideIndex = 0;
    let carouselTimer = null;

    function renderCarousel() {
      const wrapper = document.getElementById('carouselSlides');
      const dotsContainer = document.getElementById('carouselDots');
      wrapper.innerHTML = '';
      dotsContainer.innerHTML = '';

      // Pumili ng hanggang 5 trending/latest items
      const featured = PROCESSED_CATALOG.slice(0, 5);
      if (featured.length === 0) {
        document.getElementById('carouselWrapper').style.display = 'none';
        return;
      }

      featured.forEach((item, index) => {
        const slide = document.createElement('div');
        slide.className = `carousel-slide ${index === 0 ? 'active' : ''}`;
        slide.innerHTML = `
          <img src="${item.image || 'https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=800'}" class="w-full h-full object-cover">
          <div class="absolute inset-0 bg-gradient-to-t from-[#08090d] via-[#08090d]/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4 space-y-1.5 text-left">
            <div class="flex items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-rose-600 text-white font-extrabold text-[8.5px] uppercase tracking-wider">🔥 Trending</span>
              <span class="text-[9.5px] font-bold text-amber-300">⭐ ${item.rating || '8.5'}</span>
              <span class="text-[9.5px] text-zinc-400 font-mono">${item.year || '2024'}</span>
            </div>
            <h2 class="text-sm font-black text-white truncate drop-shadow-md">${item.title}</h2>
            <button onclick="${item.isSeries ? `openSeriesEpisodes('${encodeURIComponent(JSON.stringify(item))}')` : `handlePlayClick('${item.id}')`}" class="px-4 py-1.5 rounded-xl bg-gradient-to-r from-rose-600 to-rose-500 text-white font-extrabold text-xs shadow-lg flex items-center gap-1.5 active:scale-95 transition">
              <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
              <span>${item.isSeries ? 'VIEW EPISODES' : 'WATCH NOW'}</span>
            </button>
          </div>
        `;
        wrapper.appendChild(slide);

        // Dot
        const dot = document.createElement('span');
        dot.className = `w-1.5 h-1.5 rounded-full transition-all duration-300 ${index === 0 ? 'w-4 bg-rose-500' : 'bg-white/40'}`;
        dotsContainer.appendChild(dot);
      });

      startCarouselAutoSlide();
    }

    function startCarouselAutoSlide() {
      clearInterval(carouselTimer);
      carouselTimer = setInterval(() => {
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.getElementById('carouselDots').children;
        if (slides.length <= 1) return;

        slides[currentSlideIndex].classList.remove('active');
        dots[currentSlideIndex].className = 'w-1.5 h-1.5 rounded-full bg-white/40 transition-all duration-300';

        currentSlideIndex = (currentSlideIndex + 1) % slides.length;

        slides[currentSlideIndex].classList.add('active');
        dots[currentSlideIndex].className = 'w-4 h-1.5 rounded-full bg-rose-500 transition-all duration-300';
      }, 4500);
    }

    // 📺 4. RENDER CATALOG CARDS
    function renderCatalog() {
      const container = document.getElementById('moviesContainer');
      container.innerHTML = '';

      if (PROCESSED_CATALOG.length === 0) {
        container.innerHTML = '<div class="p-6 text-center text-xs text-zinc-500 bg-[#131622] rounded-xl border border-[#1f2436]">Walang palabas sa database.</div>';
        return;
      }

      PROCESSED_CATALOG.forEach(item => {
        const card = document.createElement('div');
        card.className = 'card-movie p-3 flex items-center justify-between gap-3';
        card.setAttribute('data-title', item.title.toLowerCase());

        // Thumbnail
        const thumbHtml = `
          <div class="w-20 h-24 rounded-lg bg-[#191c2b] overflow-hidden flex-shrink-0 relative border border-[#22283d]">
            ${item.image ? `<img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover" loading="lazy">` : `<div class="w-full h-full flex items-center justify-center text-2xl text-zinc-600">🎬</div>`}
          </div>
        `;

        // Action Button
        let actionBtn = '';
        if (item.isSeries) {
          const epCount = item.episodes.length;
          actionBtn = `
            <button 
              type="button"
              onclick="openSeriesEpisodes('${encodeURIComponent(JSON.stringify(item))}')"
              class="px-3 py-2 rounded-xl bg-indigo-600 active:bg-indigo-700 text-white text-[11px] font-extrabold shadow-md flex items-center gap-1 hover:bg-indigo-500 transition cursor-pointer"
            >
              <i data-lucide="layers" class="w-3.5 h-3.5"></i>
              <span>EPISODES (${epCount})</span>
            </button>
          `;
        } else {
          actionBtn = `
            <button 
              type="button"
              onclick="handlePlayClick('${item.id}')"
              class="px-4 py-2 rounded-xl bg-rose-600 active:bg-rose-700 text-white text-xs font-extrabold shadow-md flex items-center gap-1 hover:bg-rose-500 transition cursor-pointer"
            >
              <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
              <span>PLAY</span>
            </button>
          `;
        }

        card.innerHTML = `
          ${thumbHtml}
          <div class="flex-1 min-w-0 space-y-1">
            <h3 class="text-xs font-black text-white truncate" title="${item.title}">
              ${item.title}
            </h3>

            <!-- BADGES -->
            <div class="flex items-center gap-1.5 flex-wrap text-[9px] font-bold">
              <span class="px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30">
                ⭐ ${item.rating || '8.5'}
              </span>
              <span class="px-1.5 py-0.5 rounded ${item.isSeries ? 'bg-indigo-500/20 text-indigo-300 border border-indigo-500/30' : 'bg-blue-500/20 text-blue-300 border border-blue-500/30'} uppercase">
                ${item.isSeries ? 'SERIES' : 'MOVIE'}
              </span>
              <span class="px-1.5 py-0.5 rounded bg-[#1b1f2e] text-zinc-400 font-mono">
                ${item.year || '2024'}
              </span>
            </div>

            <p class="text-[10px] text-zinc-400 font-semibold">
              ${item.isSeries ? `📺 Kumpletong ${item.episodes.length} Episodes` : `📦 ${item.size || 'HD Stream'}`}
            </p>
          </div>

          <div class="flex-shrink-0">
            ${actionBtn}
          </div>
        `;

        container.appendChild(card);
      });

      lucide.createIcons();
    }

    // 📺 5. OPEN EPISODE SELECTOR MODAL
    function openSeriesEpisodes(encodedJson) {
      const series = JSON.parse(decodeURIComponent(encodedJson));
      document.getElementById('epModalTitle').innerText = series.title;
      document.getElementById('epModalSub').innerText = `${series.episodes.length} Episodes Available`;

      const listContainer = document.getElementById('episodesListContainer');
      listContainer.innerHTML = '';

      series.episodes.forEach(ep => {
        const itemBtn = document.createElement('div');
        itemBtn.className = 'p-3 rounded-xl bg-[#0c0d14] border border-[#1f2436] flex items-center justify-between gap-3 active:scale-98 transition cursor-pointer hover:border-indigo-500';
        itemBtn.onclick = () => {
          closeEpisodeModal();
          handlePlayClick(ep.id);
        };

        itemBtn.innerHTML = `
          <div class="flex items-center gap-2.5 overflow-hidden">
            <span class="w-7 h-7 rounded-lg bg-indigo-600/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center font-black text-xs flex-shrink-0">
              E${ep.episode}
            </span>
            <div class="truncate">
              <div class="text-xs font-bold text-white truncate">Season ${ep.season} Episode ${ep.episode}</div>
              <div class="text-[9px] text-zinc-500 font-mono">${ep.size}</div>
            </div>
          </div>
          <button class="px-3 py-1 rounded-lg bg-indigo-600 text-white text-[10px] font-extrabold flex items-center gap-1 flex-shrink-0">
            <i data-lucide="play" class="w-3 h-3 fill-current"></i> PLAY
          </button>
        `;
        listContainer.appendChild(itemBtn);
      });

      const modal = document.getElementById('episodeModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      lucide.createIcons();
    }

    function closeEpisodeModal() {
      const modal = document.getElementById('episodeModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // 🔍 6. LIVE SEARCH
    function liveFilterMovies() {
      const query = document.getElementById('searchInput').value.toLowerCase().trim();
      const cards = document.querySelectorAll('.card-movie');
      let visibleCount = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        if (title.includes(query)) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });
    }

    // 7. USER IDENTITY & VIP LOGIC
    let userUid = localStorage.getItem('user_uid') || '';
    let userName = localStorage.getItem('user_name') || '';

    try {
      if (window.Telegram?.WebApp) {
        window.Telegram.WebApp.ready();
        if (window.Telegram.WebApp.initDataUnsafe?.user) {
          const tgUser = window.Telegram.WebApp.initDataUnsafe.user;
          userUid = String(tgUser.id);
          userName = tgUser.first_name + (tgUser.username ? ' (@' + tgUser.username + ')' : '');
          try { window.Telegram.WebApp.expand(); } catch(e) {}
        }
      }
    } catch(e) {}

    if (!userUid) {
      userUid = 'TG_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6);
      userName = 'User_' + Math.floor(1000 + Math.random() * 9000);
    }
    localStorage.setItem('user_uid', userUid);
    localStorage.setItem('user_name', userName);

    let isUserVip = false;
    let selectedPlan = '5 Pesos Donate';
    let selectedAmount = '5';
    let selectedMethod = 'GCASH';

    async function checkVip() {
      try {
        const res = await fetch(`/api/vip/status/${userUid}`);
        const data = await res.json();
        if (data && data.isVip) isUserVip = true;
      } catch(e) {}
    }
    checkVip();

    function handlePlayClick(fileId) {
      if (isUserVip) {
        window.location.href = `/embed/${fileId}`;
      } else {
        openVipModal('plans');
      }
    }

    function openVipModal(tab) {
      const modal = document.getElementById('vipPaymentModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      switchPlanTab(tab);
    }

    function closeVipModal() {
      const modal = document.getElementById('vipPaymentModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function switchPlanTab(tab) {
      const donateSec = document.getElementById('donateSection');
      const plansSec = document.getElementById('plansSection');
      const tabDonateBtn = document.getElementById('tabDonateBtn');
      const tabPlansBtn = document.getElementById('tabPlansBtn');

      if (tab === 'donate') {
        donateSec.classList.remove('hidden');
        plansSec.classList.add('hidden');
        tabDonateBtn.className = 'py-1 text-xs font-bold rounded-lg bg-amber-500 text-black';
        tabPlansBtn.className = 'py-1 text-xs font-semibold rounded-lg text-zinc-400';
        selectedPlan = '5 Pesos Donate';
        selectedAmount = '5';
      } else {
        donateSec.classList.add('hidden');
        plansSec.classList.remove('hidden');
        tabPlansBtn.className = 'py-1 text-xs font-bold rounded-lg bg-amber-500 text-black';
        tabDonateBtn.className = 'py-1 text-xs font-semibold rounded-lg text-zinc-400';
        selectVipPlan('Monthly Plan', '50');
      }
    }

    function selectVipPlan(name, amount) {
      selectedPlan = name;
      selectedAmount = amount;
      document.querySelectorAll('.vip-plan-card').forEach(c => c.classList.remove('border-amber-500'));
      if (event?.currentTarget) event.currentTarget.classList.add('border-amber-500');
    }

    function setMethod(method) {
      selectedMethod = method;
      const box = document.getElementById('accountInfoBox');
      if (method === 'GCASH') {
        box.innerHTML = `<div>GCASH: <span class="font-bold text-white"><%= paymentConfig.gcash_number || '09638924040' %></span></div><div class="text-[9px] text-zinc-400">NAME: <%= paymentConfig.gcash_name || 'PINOMAX ADMIN' %></div>`;
      } else {
        box.innerHTML = `<div>PAYPAL: <span class="font-bold text-white"><%= paymentConfig.paypal_email || 'payments@pinomax.com' %></span></div><div class="text-[9px] text-zinc-400">Send as Friends &amp; Family</div>`;
      }
    }

    async function submitPaymentRequest() {
      const ref = document.getElementById('vipRefInput').value.trim();
      const statusMsg = document.getElementById('modalStatusMsg');
      if (!ref) return alert('Ilagay ang Ref#!');

      statusMsg.className = 'text-center text-[10px] text-amber-400 block';
      statusMsg.innerText = 'Ipinapasa ang bayad...';

      try {
        const res = await fetch('/api/vip/submit-request', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            uid: userUid,
            userName: userName,
            planName: selectedPlan,
            amount: selectedAmount,
            method: selectedMethod,
            refNumber: ref
          })
        });
        const data = await res.json();
        if (data.success) {
          statusMsg.className = 'text-center text-[10px] text-emerald-400 block';
          statusMsg.innerText = '✅ Naisumite na sa Admin!';
          document.getElementById('vipRefInput').value = '';
          setTimeout(() => { closeVipModal(); checkVip(); }, 2000);
        }
      } catch(e) {
        statusMsg.className = 'text-center text-[10px] text-rose-400 block';
        statusMsg.innerText = '❌ Error sa pagpasa.';
      }
    }

    // Initialize Page
    document.addEventListener('DOMContentLoaded', () => {
      renderCarousel();
      renderCatalog();
    });
  </script>
</body>
</html>